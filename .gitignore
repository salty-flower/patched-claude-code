/result
/result-*
node_modules/
.direnv/

# Per-user bundle staging
/staging/
/dist/
/prompts/
*.patched.js

# Per-target extracted slice bundles (regeneratable from sourcemap + bundles)
/extracted/

# Vendored npm packages embedded in the reference tree are not audit-
# relevant; we only patch Anthropic-authored code under sources/src/.
# Regenerate by re-running tools/extract-sources.ts.
/reference/*/sources/node_modules/

# Bun lockfile + cache (committed deliberately when present)
!bun.lock
!bun.lockb

# Editor noise
.vscode/
*.swp
.DS_Store
