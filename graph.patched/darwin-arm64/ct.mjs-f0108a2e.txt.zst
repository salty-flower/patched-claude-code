#!/usr/bin/env node
// ct.mjs — the claude-test plugin's helper: the skills pre-approve most of its commands, never "allow" (it can take back a yes the person gave).
//   node ct.mjs status            print project config, dev-server state and spec list (JSON)
//   node ct.mjs new-run           create .claude-test/runs/<id>/ and print its path (JSON)
//   node ct.mjs prefs [live-page open|link]   the person's own choices on this machine: whether a run opens its live page in the browser (open) or only prints its address (link)
//   node ct.mjs allow [--remove <address>…]   print the addresses the person has allowed for this project and the ones it waits for; with --remove, drop entries. Allowing is NOT done here: no command can. The browser helper asks the person in a dialog of Claude Code's own (lib/allow-tool.mjs)
//   node ct.mjs finish            write <run>/results.json from the log.md the run just wrote (machine-readable verdicts)
//   node ct.mjs write-spec <name> [<name> …]  create .claude-test/specs/<name>.md from <run>/proposed/<name>.md — new files only; --replace <name> corrects one spec git has never recorded
//   node ct.mjs file --run <id> [--only <new,…>] [--replace <existing,…>] | --none   the runner's FIRST command, once per run: save the named drafts as NEW specs (--only; an existing name is held) or as corrections (--replace; previous text kept); seals the run
//   node ct.mjs drafts            for a terminal: what each draft in <run>/proposed/ holds, as data (JSON; reads only). No skill calls it.
//   node ct.mjs progress start | <stem> <PASS|FAIL|BLOCKED>  the runner: open <run>/progress.ndjson (its answer says what became of opening the live page), then append one line per finished spec; with no arguments, print the lines so far
//   node ct.mjs changes           files changed since the last finished run's commit (and uncommitted): names, kind, changed line ranges, and which of them no spec names as a source — never file content (JSON)
//   node ct.mjs install [browser] [--no-lock] [--allow-fallback] [--download-host=https://mirror]  install the browser tooling into <data>/tools, in the plugin's data folder (npm ci against the
//                                 lockfile shipped with the plugin) and download a browser (default: chromium) unless Chrome is present
//   (login / logout / sign-in / scaffold-sign-in live in ct-auth.mjs — the commands that touch credentials or
//    run repository code are a separate script so no approval rule for this one can cover them)
// It takes no full URL from its arguments except same-origin paths and, for "allow --remove", addresses already in the person's record; it never runs
// text from spec files, and writes only under .claude-test/runs/ — plus write-spec, which creates (never replaces) one file in .claude-test/specs/, and prefs and allow --remove, which write the person's own choices outside the project (prefs in their private folder, allow --remove in the record under lib/config.mjs consentDir). The project it acts on is
// never an argument either: it is the nearest marked/app folder under what Claude Code opened (CLAUDE_PROJECT_DIR / CLAUDE_TEST_PROJECT_DIR), honouring an app: line, else the
// current directory, so a pre-approved "ct.mjs <cmd> *" rule cannot be pointed at another
// project's settings or saved sign-in by text the agent read.
import fs from 'node:fs';
import { createHash, randomBytes } from 'node:crypto';
import os from 'node:os';
import path from 'node:path';
import http from 'node:http';
import https from 'node:https';
import net from 'node:net';
import { spawn } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { execFileSync } from 'node:child_process';
import { loadConfig, consentKey, readConsent, writeConsent, isLocalHost, privateDir, reallyInsideDir, fromComment, listSpecs, ensureRunsDir, assertRunsDirInsideProject, parseSpec, mintSpecId, withSpecId, shown, shownDeep, shownText, parseDotenv, resolveProjectDir, projectDirReason, projectsBelow, sessionRoot, specsDirProblem, appPointerInfo, rootConfiguresItself, sanitizeBrowserEnv, trackedClaudeTestSymlinks, RC_FILE, GIT_SAFE_ARGS, joinWrappedCriteria, liveDir, stemOk } from './lib/config.mjs';
import { ALLOW_TOOL, UP_TOOL } from './lib/allow-tool.mjs';
import { runFolders, runStart, writeInRunFolder } from './lib/runs.mjs';
import { openerCommand, openerEnv, runOpener } from './lib/open-page.mjs';
import { pathToFileURL } from 'node:url';
import { groupRefusedHosts } from './lib/hosts.mjs';
import { toolsDir, mcpCliPath, installTools, toolsInstallInfo, findChrome, browsersDir, useOwnBrowsersIfPresent, toolsProblem, browserProblem, tightenToolsDir } from './lib/tools.mjs';
import { listSkills, authFileInfo, bypassHints } from './lib/signin.mjs';
import { readJson, discoverDevServer, candidateList, COMMON_PORTS } from './lib/discover.mjs';
import { environmentReport } from './lib/envreport.mjs';

const args = process.argv.slice(2);
const projectDir = resolveProjectDir();
const PLAYWRIGHT_DOWNLOAD_HOST_SEEN = !!process.env.PLAYWRIGHT_DOWNLOAD_HOST; // noted before the scrub below removes it: install tells the user to use --download-host instead
sanitizeBrowserEnv(); // before anything imports Playwright (login, sign-in, the skill child all inherit this environment)
const cmd = args[0] || 'status';
const scrubWhole = (x) => typeof x === 'string' ? shownText(x).replace(/\r(?!\n)|[\u{E0000}-\u{E007F}\u{E0100}-\u{E01EF}]/gu, ' ') : Array.isArray(x) ? x.map(scrubWhole) : x && typeof x === 'object' ? Object.fromEntries(Object.entries(x).map(([k, y]) => [k, scrubWhole(y)])) : x; // scrubbed of control characters, never cut: consent rests on seeing all of it
const out = (obj) => { const plain = obj && typeof obj === 'object' && !Array.isArray(obj); const { text, results, flagged: topFlagged, ...rest } = plain ? obj : {}; const clean = shownDeep(plain ? rest : obj); if (plain && typeof text === 'string') clean.text = text; if (plain && topFlagged) clean.flagged = scrubWhole(topFlagged); if (plain && Array.isArray(obj.held)) clean.held = obj.held.map((h) => { const { flagged: fl, ...hh } = h || {}; const c = shownDeep(hh); if (fl) c.flagged = scrubWhole(fl); return c; }); /* a held draft's flagged list is whole too (ct.mjs file) */ if (plain && Array.isArray(results)) clean.results = results.map((r) => { const { text: t, flagged: fl, ...rr } = r || {}; const c = shownDeep(rr); if (typeof t === 'string') c.text = t; if (fl) c.flagged = scrubWhole(fl); return c; }); else if (plain && results !== undefined) clean.results = shownDeep(results); process.stdout.write(JSON.stringify(clean, null, 2) + '\n'); }; // every string scrubbed of control/bidi characters and capped (lib/config.mjs shown): repo- and page-derived text is echoed here — except write-spec's "text" (the spec it just filed, checked for control characters before it was written), which keeps its line breaks, and a refusal's "flagged" lists, which are scrubbed but never cut (consent rests on seeing all of them)

async function get(url, timeoutMs = 8000) { // a dev server compiling its first page (Vite, Next) can take several seconds
  // "localhost" may resolve to only one of 127.0.0.1 / ::1 while the server listens on the other
  // (Vite on macOS binds ::1). Try the name first, then both literals.
  const r = await getOnce(url, timeoutMs);
  let u; try { u = new URL(url); } catch { return r; }
  if (r.up || u.hostname !== 'localhost') return r;
  let unknown = r.up === null ? r : null;
  let refused = r.up === false ? r : null;
  for (const h of ['127.0.0.1', '[::1]']) {
    u.hostname = h; const r2 = await getOnce(u.href, timeoutMs);
    if (r2.up) return { ...r2, via: h };
    if (h === '[::1]' && r2.up === null && FAMILY_ABSENT.has(r2.code)) continue; // no IPv6 on this host: ignore the literal entirely
    if (r2.up === null && !unknown) unknown = { ...r2, via: h };
    if (r2.up === false && !refused) refused = { ...r2, via: h };
  }
  if (unknown && refused && unknown.via === undefined && FAMILY_ABSENT.has(unknown.code)) unknown = null; // the name resolved to an absent family; the IPv4 literal answered plainly
  return unknown || refused || r; // "unknown" beats "refused": one denied literal means the shell's view cannot be trusted
}

function getOnce(url, timeoutMs = 8000) {
  return new Promise((resolve) => {
    const lib = url.startsWith('https:') ? https : http;
    const req = lib.get(url, { timeout: timeoutMs, headers: { 'user-agent': 'claude-test/0.1' } }, (res) => {
      let body = '';
      res.setEncoding('utf8');
      res.on('data', (c) => { if (body.length < 4096) body += c; });
      res.on('end', () => {
        // The page title is page-controlled text shown to the agent: one short printable line only.
        const rawTitle = (body.match(/<title[^>]*>([^<]{0,200})<\/title>/i) || [])[1] || null;
        const title = rawTitle === null ? null : rawTitle.replace(/[\u0000-\u001f\u007f]+/g, ' ').trim().slice(0, 100);
        resolve({ up: true, status: res.statusCode, contentType: res.headers['content-type'] || null, title });
      });
    });
    req.on('timeout', () => { req.destroy(); resolve({ up: null, error: 'timeout (no answer within ' + timeoutMs + ' ms) — unknown, not down; a dev server compiling its first page does this' }); });
    req.on('error', (e) => resolve(e.code !== 'ECONNREFUSED' || IN_SANDBOX ? { up: null, error: SANDBOX_CODES.has(e.code) || IN_SANDBOX ? 'blocked' : 'unknown', code: e.code, blocked: (SANDBOX_CODES.has(e.code) || IN_SANDBOX ? 'this process is not permitted to connect to ' + new URL(url).host + ' (' + e.code + ') — a sandbox (Claude Code\'s, or the OS\'s) is denying loopback connections' : 'connecting to ' + new URL(url).host + ' from the shell failed with ' + (e.code || e.message) + ', which is not a plain refusal') + '; the server may well be running — only the browser preflight decides' } : { up: false, error: 'refused (ECONNREFUSED) — nothing accepted the connection from the shell; still only advisory: the browser preflight decides' }));
  });
}

// EPERM / EACCES on a loopback connect is not "nothing listening": the connection was refused before it was tried.
// Remember that it happened so status can say so.
const SANDBOX_CODES = new Set(['EPERM', 'EACCES']);
// With SANDBOX_RUNTIME=1 no network answer from here says anything about the dev server: status then does
// file-only work and says so.
const SANDBOX_WHY = (() => {
  if (process.env.SANDBOX_RUNTIME === '1') return 'SANDBOX_RUNTIME=1';
  const px = (process.env.HTTPS_PROXY || process.env.HTTP_PROXY || process.env.https_proxy || process.env.http_proxy || '');
  const np = (process.env.NO_PROXY || process.env.no_proxy || '');
  if (/^(https?:\/\/)?(srt[^/@]*@)?(localhost|127\.0\.0\.1|\[?::1\]?):\d+(\/|$)/i.test(px) && /(^|,)\s*(localhost|127\.0\.0\.1)\s*(,|$)/i.test(np)) return 'a local proxy with NO_PROXY=localhost (the shape Claude Code\'s sandbox gives every command; possibly just a local proxy of yours)';
  return null;
})();
const IN_SANDBOX = SANDBOX_WHY !== null;
const FAMILY_ABSENT = new Set(['EADDRNOTAVAIL', 'EAFNOSUPPORT', 'ENETUNREACH', 'EHOSTUNREACH', 'EINVAL']); // IPv6 switched off (Docker/CI images): the ::1 attempt cannot even be made — that says nothing about a sandbox
let sandboxDenied = null;
async function portOpen(port, host = null, timeoutMs = 400) {
  if (!host) return (await portOpen(port, '127.0.0.1', timeoutMs)) || (await portOpen(port, '::1', timeoutMs));
  return new Promise((resolve) => {
    const s = net.connect({ port, host });
    const done = (v) => { s.destroy(); resolve(v); };
    s.setTimeout(timeoutMs, () => { sandboxDenied = sandboxDenied || 'timeout'; done(false); }); // a silent drop is not a refusal either
    s.on('connect', () => done(true));
    s.on('error', (e) => { if (e.code !== 'ECONNREFUSED' && !(host === '::1' && FAMILY_ABSENT.has(e.code))) sandboxDenied = e.code || 'error'; done(false); }); // anything but a clean refusal makes the scan untrustworthy — except "no IPv6 on this host" on the ::1 attempt, which says nothing
  });
}

// How many KEY=value lines the secrets file holds — a count, not the names: status output reaches the
// forked agent, and a spec must already know a key's name to have it typed.
function secretKeyCount(p) { try { return Object.values(parseDotenv(fs.readFileSync(p, 'utf8'))).filter((v) => v !== '').length; } catch { return 0; } } // the server's own dotenv rules (lib/config.mjs), so status, the launcher's guard and the server agree on the key set
/** A .claude-test folder marks an app folder only when it holds specs or settings — a stray runs/ folder (left by an older
 *  run started in the wrong place) does not. */
function markedByClaudeTestDir(dir) { try { const ents = fs.readdirSync(path.join(dir, '.claude-test')); return ents.some((e) => e !== 'runs' && e !== '.gitignore'); } catch { return false; } }
/** Member folders of an unmarked workspace root that look like apps (a package.json with a dev/start/serve script), ≤ 8. */
/** A folder name safe to print and to offer as an rc value: printable ASCII, no quotes, #, colon tricks or newlines, ≤ 80 chars. */
function safeRel(rel) { return typeof rel === 'string' && rel.length > 0 && rel.length <= 80 && /^[\w.@+ /-]+$/.test(rel) && !rel.split('/').includes('..') ? rel : null; }
function hasDevScript(d) { const pkg = readJson(path.join(d, 'package.json')); return !!(pkg && pkg.scripts && ['dev', 'start'].some((s) => pkg.scripts[s] || Object.keys(pkg.scripts).some((k) => k.startsWith(s + ':')))); } // a bundle-serving "serve"/"preview" does not make a folder the app
function looksLikeApp(d) { const pkg = readJson(path.join(d, 'package.json')); return !!(pkg && pkg.scripts && ['dev', 'start', 'serve', 'preview'].some((s) => pkg.scripts[s] || Object.keys(pkg.scripts).some((k) => k.startsWith(s + ':')))) || ['manage.py', 'Gemfile', 'mix.exs', 'go.mod', 'Cargo.toml'].some((f) => fs.existsSync(path.join(d, f))); }
function appFoldersBelow(dir) { // depth ≤ 2 (apps/x, packages/x, services/x, any direct child), ≤ 20
  const out = [];
  const walk = (d, left) => { if (out.length >= 12) return; let ents; try { ents = fs.readdirSync(d, { withFileTypes: true }); } catch { return; } if (d !== dir && looksLikeApp(d)) { out.push(path.relative(dir, d)); return; } if (left === 0) return; for (const e of ents) if (e.isDirectory() && !e.name.startsWith('.') && !['node_modules', 'dist', 'build', 'vendor', 'target', 'coverage', 'out', 'tmp'].includes(e.name)) walk(path.join(d, e.name), left - 1); };
  walk(dir, 2);
  return out;
}
/** Whether the resolved folder should be worked in at all, and the one-line reason when not (status prints it first; new-run
 *  refuses with it so nothing is ever created at a workspace root or a non-app folder). */
function folderVerdict(cfg) {
  const looksLikeProject = cfg.rcFound || markedByClaudeTestDir(cfg.projectDir) || ['package.json', 'manage.py', 'Gemfile', 'pyproject.toml', 'requirements.txt', 'Pipfile', 'go.mod', 'Cargo.toml', 'composer.json', 'mix.exs', 'deno.json', 'index.html', 'Procfile', 'docker-compose.yml', 'pom.xml', 'build.gradle', 'config.toml', 'hugo.toml', 'Makefile'].some((f) => fs.existsSync(path.join(cfg.projectDir, f))) || (() => { try { return fs.readdirSync(cfg.projectDir).some((e) => /\.(csproj|sln|fsproj)$/.test(e)); } catch { return false; } })();
  const isWorkspaceRoot = ['pnpm-workspace.yaml', 'turbo.json', 'nx.json', 'lerna.json', 'rush.json'].some((f) => fs.existsSync(path.join(cfg.projectDir, f))) || !!(readJson(path.join(cfg.projectDir, 'package.json')) || {}).workspaces;
  const markedHere = cfg.rcFound || markedByClaudeTestDir(cfg.projectDir);
  // The rule is about APPS, not markers: whenever this folder has no .claude-testrc of its own (the user's word), look at the
  // app folders below it (depth ≤ 2: package.json with a dev/start/serve script, or another app marker): ANY app folder below
  // means "more than one app" → ask once which (the answer — an app: line, or this folder's own .claude-testrc — persists).
  // Folders that already carry Claude Test files are listed first; "this folder itself" is a choice whenever the folder looks
  // like a project, first when its suite is committed to git (intent), last otherwise (an untracked suite at a root is usually
  // a leftover of a run started in the wrong place).
  let below = [], belowKind = 'app folders below it', blocked = false, suiteTrackedForLine = false, unprintable = 0;
  const ptr = cfg.projectDir === sessionRoot() ? appPointerInfo(sessionRoot()) : null; // at the root: does its rc (try to) point at an app?
  const rcConfiguresHere = cfg.rcFound && (cfg.projectDir !== sessionRoot() || rootConfiguresItself(cfg.projectDir)) && !(ptr && ptr.problem); // an rc holding only "app: …" does not make the root the app, and a BROKEN app: line always reopens the question
  if (!rcConfiguresHere) {
    const markedAll = projectsBelow(cfg.projectDir), appsAll = appFoldersBelow(cfg.projectDir).filter((a) => !markedAll.includes(a));
    const marked = markedAll.filter(safeRel), apps = appsAll.filter(safeRel); // a folder whose name is not plainly printable is never listed or offered (it could smuggle rc lines) …
    unprintable = markedAll.length + appsAll.length - marked.length - apps.length; // … but it still COUNTS: a root with only such app folders below must keep asking, never become the app
    below = [...marked, ...apps];
    if (marked.length && apps.length) belowKind = 'app folders below it (' + marked.join(', ') + ' already with Claude Test files)';
    else if (marked.length) belowKind = 'app folders below it with Claude Test files';
    const suiteTracked = (() => { try { return execFileSync('git', [...GIT_SAFE_ARGS, 'ls-files', '--', '.claude-test/specs'], { cwd: cfg.projectDir, stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim() !== ''; } catch { return false; } })(); // a committed suite is intent; an untracked one at a root is usually a leftover
    const selfIsApp = hasDevScript(cfg.projectDir) || suiteTracked; suiteTrackedForLine = suiteTracked;
    blocked = below.length >= 1 || unprintable > 0 || (isWorkspaceRoot && !selfIsApp && !markedHere) || !looksLikeProject || !!(ptr && ptr.problem); // any app folder below (listed or not) means "more than one app": ask once (the answer persists); a broken app: line always asks again
    if (blocked && below.length && (selfIsApp || looksLikeProject)) below = suiteTracked ? ['.', ...below] : [...below, '.']; // "this folder" is always answerable; first when its suite is committed (intent), last otherwise
  }
  const unprintableNote = unprintable ? ' (' + unprintable + ' app folder' + (unprintable > 1 ? 's' : '') + ' with ' + (unprintable > 1 ? 'names' : 'a name') + ' I cannot print safely ' + (unprintable > 1 ? 'are' : 'is') + ' not listed — if ' + (unprintable > 1 ? 'one of them' : 'it') + ' is the app, add "app: <folder>" to ' + path.join(sessionRoot(), RC_FILE) + ' yourself)' : '';
  const line = blocked ? 'BLOCKED — ' + (ptr && ptr.problem ? ptr.problem + '; ' : '') + (path.relative(sessionRoot(), cfg.projectDir) || 'the session root (' + cfg.projectDir + ')') + (below.length ? (markedByClaudeTestDir(cfg.projectDir) ? ' has a Claude Test suite AND ' : ' has ') + belowKind + ': ' + below.filter((b) => b !== '.').join(', ') + ' — which app?' + (markedByClaudeTestDir(cfg.projectDir) && !suiteTrackedForLine ? ' (the untracked suite here is usually a leftover of a run started in the wrong place; never add to it unanswered)' : below.includes('.') ? ' (this folder itself is one of the choices)' : ' (never write a suite here)') + '. status.needsInput carries the question — end the run with it (SKILL.md §6, NEEDS INPUT); only when the user\'s request itself named the app folder run the helper from there ("cd <dir> && node …/ct.mjs status")' : unprintable && looksLikeProject ? ' has app folders below it — which app? status.needsInput carries the question — end the run with it (SKILL.md §6, NEEDS INPUT)' : ' does not look like an app folder (no app manifest such as package.json, no .claude-testrc, no Claude Test specs); run the helper from the app folder you mean ("cd <dir> && node …/ct.mjs status"), or ask the user which folder. If this folder IS the app, a .claude-testrc here (baseUrl: http://localhost:<port>) settles it') + unprintableNote : null;
  // From a subfolder with no specs of its own: say where Claude Test files DO exist under the session root, instead of a bare "0 specs".
  let elsewhere = [];
  const rootPtr = appPointerInfo(sessionRoot());
  if (!blocked && !markedHere && cfg.projectDir !== sessionRoot() && !(rootPtr && rootPtr.dir)) elsewhere = projectsBelow(sessionRoot()).filter(safeRel).map((r) => path.relative(cfg.projectDir, path.join(sessionRoot(), r)) || '.').filter((r) => r !== '.'); // with an app: line already answered, being in another app folder is deliberate — no second question
  // NEEDS INPUT: the fork cannot know which app — one question, the choices found, and for each the exact .claude-testrc line
  // (written once by the user or the main conversation; the next run reads it and never asks again).
  let needsInput = null;
  const rootRc = path.join(sessionRoot(), RC_FILE);
  if (blocked && below.length) needsInput = { key: 'app', question: 'This folder holds more than one app, or is not itself the app. Which app should Claude Test use?', choices: below.map((b) => b === '.' ? { answer: 'this folder itself', rcLine: 'baseUrl: http://localhost:<port>', file: path.join(cfg.projectDir, RC_FILE) } : { answer: b, rcLine: 'app: ' + path.relative(sessionRoot(), path.join(cfg.projectDir, b)), file: rootRc }).filter((ch) => ch.answer === 'this folder itself' || safeRel(ch.rcLine.slice(5))), thenRun: 'run status again and carry on (when the answer came in a later turn, the person types /claude-test:run again instead). If a browser call already happened in this session and that app folder has its own .claude-testrc with origins or sign-in settings, the person runs /mcp → reconnect the claude-test browser server first, or starts a new session' };
  else if (blocked) needsInput = { key: 'app', question: (unprintable ? 'This folder has app folders below it whose names I cannot print safely. Which folder is the app?' : 'This folder does not look like the app. Which folder is it?') + ' (or, if it IS this one, say where the app answers)', choices: [{ answer: '<app folder>', rcLine: 'app: <relative path to the app folder>', file: rootRc }, { answer: 'this folder', rcLine: 'baseUrl: http://localhost:<port>', file: path.join(cfg.projectDir, RC_FILE) }], thenRun: 'run status again and carry on (when the answer came in a later turn, the person types /claude-test:run again instead). If a browser call already happened in this session and that app folder has its own .claude-testrc with origins or sign-in settings, the person runs /mcp → reconnect the claude-test browser server first, or starts a new session' };
  else if (elsewhere.length) needsInput = { key: 'app', question: 'This folder has no Claude Test specs, but ' + elsewhere.join(', ') + ' ' + (elsewhere.length === 1 ? 'does' : 'do') + '. Reuse those (point the root at that app), or start fresh here?', choices: [...elsewhere.map((e) => ({ answer: 'reuse ' + e, rcLine: 'app: ' + path.relative(sessionRoot(), path.join(cfg.projectDir, e)), file: rootRc })).filter((ch) => safeRel(ch.rcLine.slice(5))), { answer: 'start fresh here', rcLine: 'baseUrl: http://localhost:<port>', file: path.join(cfg.projectDir, RC_FILE) }], thenRun: 'run status again and carry on (when the answer came in a later turn, the person types /claude-test:run again instead). If a browser call already happened in this session and that app folder has its own .claude-testrc with origins or sign-in settings, the person runs /mcp → reconnect the claude-test browser server first, or starts a new session' };
  return { blocked, line, below, elsewhere, needsInput };
}
async function status() {
  const cfg = loadConfig(projectDir);
  const dev = discoverDevServer(cfg, { inSandbox: IN_SANDBOX });
  let baseUrl = cfg.baseUrl; let baseUrlSource = cfg.baseUrlSource; let probe = null; let answering = []; // ports the shell found answering while no address is configured
  // When nobody configured the address, the candidates the browser preflight may try, in order (port hints from the
  // repo's files first, then common dev-server defaults). Inside the sandbox this list is all status can offer.
  let candidateUrls = cfg.baseUrl ? null : true; // printed below from the same list as candidates
  // The same list with provenance: "own" = named by this project's files (a page that loads there is the app, no judgement);
  // the rest are common default ports (a page there may be any other app on this machine — the user confirms which).
  const candidates = candidateList(cfg, dev); // lib/discover.mjs: own ports first, ≤ 4 common ports, ≤ 8 in all — the SAME list loadConfig fences the browser to when no baseUrl is set
  if (IN_SANDBOX) {
