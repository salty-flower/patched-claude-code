}
function savedSessionFacts(p) { const i = authFileInfo(p); return i.present ? { cookies: i.cookies, origins: i.origins, empty: i.empty, savedMinutesAgo: i.savedMinutesAgo, earliestCookieExpiry: i.earliestCookieExpiry, expired: i.expired, ...(i.problem ? { problem: i.problem } : {}) } : {}; }

function newRun() {
  const cfg = loadConfig(projectDir);
  const symlinks = trackedClaudeTestSymlinks(cfg.projectDir, sessionRoot()); if (symlinks.length) process.stderr.write('[claude-test] note: symlink(s) inside .claude-test/: ' + symlinks.join('; ') + '\n');
  const v = folderVerdict(cfg); if (v.blocked || (v.needsInput && v.needsInput.key === 'app')) { out({ error: v.line || v.needsInput.question, ...(v.needsInput ? { needsInput: v.needsInput } : {}) }); process.exit(2); } // never create .claude-test where "which app?" is still open
  const sp = specsDirProblem(cfg); if (sp) { out({ error: sp }); process.exit(1); }
  try { ensureRunsDir(cfg); } catch (e) { out({ error: e.message }); process.exit(1); }
  const d = new Date();
  const pad = (n) => String(n).padStart(2, '0');
  let id = d.getFullYear() + '-' + pad(d.getMonth() + 1) + '-' + pad(d.getDate()) + 'T' + pad(d.getHours()) + '-' + pad(d.getMinutes()) + '-' + pad(d.getSeconds());
  let runDir = path.join(cfg.runsDir, id);
  for (let i = 2; fs.existsSync(runDir); i++) runDir = path.join(cfg.runsDir, id + '-' + i);
  fs.mkdirSync(runDir);
  let folders = []; try { folders = runFolders(cfg); } catch { /* both uses below are courtesies */ } endOldPages(cfg, folders.filter((d) => d !== path.basename(runDir)));
  try { for (const old of folders.slice(0, -8)) { const fdir = path.join(cfg.runsDir, old, 'frames'); try { if (fs.lstatSync(fdir).isDirectory()) fs.rmSync(fdir, { recursive: true, force: true }); } catch { /* none */ } } } catch { /* pruning is a courtesy */ } // step pictures are kept for the newest 8 runs; every run keeps its verdict screenshots
  let saveKey = null; try { saveKey = randomBytes(16).toString('hex'); fs.writeFileSync(path.join(runDir, 'save-key.sha256'), createHash('sha256').update(saveKey).digest('hex') + '\n', { flag: 'wx', mode: 0o600 }); } catch (e) { out({ error: 'could not write this run\'s key into ' + path.relative(cfg.projectDir, runDir) + ' (' + shown(String(e && e.message || e), 160) + '): without it the run\'s save step refuses, so no run folder was handed out' }); try { fs.rmSync(runDir, { recursive: true, force: true }); } catch { /* leave it */ } process.exit(1); } // fileCmd says what the key is for
  out({ runId: path.basename(runDir), runDir: path.relative(cfg.projectDir, runDir), absolute: runDir, ...(saveKey ? { saveKey } : {}), ...(() => { const plan = livePagePlan(cfg); const page = livePageFile(cfg, path.basename(runDir)); return { livePage: pathToFileURL(page).href, ...(openByHand(page) ? { livePageByHand: openByHand(page) } : {}), livePageOpens: plan.opens, ...(plan.opens && plan.firstOpen ? { firstOpen: true } : {}), ...(plan.why ? { livePageWhyNot: plan.why } : {}), ...(plan.blockedBySandbox ? { livePageBlockedBySandbox: true } : {}) }; })(), gitignore: path.join(path.dirname(cfg.runsDir), '.gitignore') }); // the ignore file ensureRunsDir keeps next to specs/ (both names dot-prefixed): named in full so a person can find it
}

/** Hands a finished state to the pages of older runs that still poll live-data.js in their run folder, so that they stop asking: it writes one into each of the
 *  newest 20 of olderRuns that still holds the file and has no results.json. */
function endOldPages(cfg, olderRuns) {
  try {
    for (const id of olderRuns.slice(-20)) {
      const dir = path.join(cfg.runsDir, id);
      try { if (!fs.lstatSync(path.join(dir, 'live-data.js')).isFile()) continue; } catch { continue; }
      try { fs.lstatSync(path.join(dir, 'results.json')); continue; } catch { /* never finished: its page may still be asking */ }
      let was; try { was = fs.lstatSync(dir); } catch { continue; } if (!was.isDirectory()) continue;
      writeInRunFolder(dir, 'live-data.js', 'window.__claudeTestLive && window.__claudeTestLive(' + JSON.stringify({ runId: id, rows: [], finished: true, writtenAt: new Date().toISOString() }) + ');\n');
      try { fs.lutimesSync(dir, was.atime, was.mtime); } catch { /* not the person's own folder: the next one is still done */ } // the folder keeps its own change time, never set through a link: the browser helper takes a folder that changed lately for a run that is going on
    }
  } catch { /* a courtesy to a page left open: it must not break a run */ }
}

function install() {
