#!/usr/bin/env node
// playwright-mcp.mjs — starts the Playwright MCP server for the claude-test plugin.
// Claude Code starts this as the plugin's MCP server. It reads the
// project's .claude-testrc, limits the browser to those of the addresses it names (the dev server's origin, its
// loopback twins, any allowedOrigins) that the person has allowed for this project, picks the installed Chrome when
// there is one, and then hands stdio to the real server. It prints nothing on
// stdout itself (stdout is the MCP channel); diagnostics go to stderr.
//
// Environment knobs (for CI, containers and odd machines; none are needed normally):
//   CLAUDE_TEST_BROWSER             chrome | msedge | chromium (any other browser is refused: only these can be fenced)
//   CLAUDE_TEST_HEADED=1            show the browser window
//   CLAUDE_TEST_DISABLE_MCP=1       do not start the server (simulates an org that blocks MCP)
// The server itself (node_modules/@playwright/mcp) is run from <data>/tools, where <data> is the plugin's data folder (lib/config.mjs
// dataRoot: found from these scripts' own place); `ct.mjs install` fills it, and no
// variable moves it. When it is there the server starts from it; without it a small stub answers (browser_setup_needed +
// claude_test_install) — this launcher never downloads anything itself.
import fs from 'node:fs';
import net from 'node:net';
import os from 'node:os';
import path from 'node:path';
import crypto from 'node:crypto';
import { spawn } from 'node:child_process';
import dns from 'node:dns';
import { fileURLToPath } from 'node:url';
import { makeAllowTool, ALLOW_TOOL, UP_TOOL } from './lib/allow-tool.mjs';
import { loadConfig, shown, browserServerEnv, parseDotenv, isLocalHost, ensureRunsDir, assertRunsDirInsideProject, resolveProjectDir, sessionRoot, reallyInsideDir, runsPathProblem, envPathOutsideProject, originAllowed, projectsBelow, isMarked, rootConfiguresItself, sanitizeBrowserEnv, launcherConfig } from './lib/config.mjs';
import { makeVet } from './lib/vet.mjs';
import { runFolders, placeStagedFile } from './lib/runs.mjs';
import { keepLivePage } from './lib/live-page.mjs';
import { startFenceProxy, upstreamProxySetting, noProxyMatcher, isNonPublicAddress, plainAddress } from './lib/fence-proxy.mjs';
import { makeReachableMatcher } from './lib/hosts.mjs';
import { parseSnapLine, yamlScalar, makeHoldsValueOf, judgeProbe, bypassOf, UDP_FENCE_ARGS, resolverPins, guardScript, secretVariants, makeRedactor, toolTextOf, pageUrlFromToolText } from './lib/guard.mjs';
import { mcpCliPath, findChrome, toolsDir, makeLaunchDir, installTools, writeStandInPackages, browserSelection, browserProblem, toolsProblem, toolsInstallInfo, browsersDir, expectedChromiumDirs } from './lib/tools.mjs';
import { ensureAuthFile, tidySkillCreds } from './lib/signin.mjs';

const log = (m) => process.stderr.write('[claude-test] ' + shown(m, 2000) + '\n'); // stderr reaches a terminal / Claude Code's log: no control or bidi characters from rc values, paths or tool arguments
if (process.env.CLAUDE_TEST_DISABLE_MCP === '1') { log('disabled by CLAUDE_TEST_DISABLE_MCP=1'); process.exit(0); }
// The launcher's own tool for the person's yes to an address (lib/allow-tool.mjs). One object for the whole process: whoever serves the client at the
// moment (the stub below, the setup stub, the pump in front of the real server) hands it every client message first, so its call and the client's
// answers to its question are served in any state and reach nobody else.
const allowTool = makeAllowTool({ send: (obj) => process.stdout.write(JSON.stringify(obj) + '\n') });
// LAZY START. Claude Code starts a plugin's MCP server in EVERY session of EVERY project where the plugin is enabled, whether or not anyone
// tests anything. So nothing project-related happens at start-up any more: no config or .env reads, no tree walk, no listener, no cache writes, no
// secrets loaded, no child process. "initialize" and "tools/list" are answered from a static snapshot of the pinned server's tool list
// (tools-snapshot.json); the FIRST tools/call runs the whole start-up below (boot) — config, fence, guard, secrets — exactly as it always ran, and the
// real server (or, without the tooling, the setup stub) takes the client over through the same hand-off the stub has always used, answering that call.
// CLAUDE_TEST_EAGER=1 restores the old start-at-once behaviour.
if (process.env.CLAUDE_TEST_EAGER === '1') await boot(null); else lazyServer();

function lazyServer() {
  let buf = ''; let initializeParams = null; let booted = false;
  const ct = fileURLToPath(new URL('./ct.mjs', import.meta.url));
  const snapshotTools = () => { try { const j = JSON.parse(fs.readFileSync(fileURLToPath(new URL('./tools-snapshot.json', import.meta.url)), 'utf8')); return Array.isArray(j.tools) ? j.tools : []; } catch { return []; } };
  const noArgs = { type: 'object', properties: {}, additionalProperties: false };
  const setupTools = [
    { name: 'browser_setup_needed', description: 'Call this when a browser_* tool of this server answered that the Claude Test browser tooling is not usable on this machine: it says what is missing and the one fix.', inputSchema: noArgs },
    { name: 'claude_test_install', description: 'Install the Claude Test browser tooling now (the same as running  node ' + ct + ' install  in a terminal, minus the browser download): an npm ci of the pinned Playwright packages into the plugin\'s data folder, using your npm configuration. Takes up to a minute.', inputSchema: noArgs },
  ];
  const send = (obj) => process.stdout.write(JSON.stringify(obj) + '\n');
  const onEnd = () => process.exit(0);
  /** What a browser call is told while the person has allowed no address for this project, or null. Start-up refuses to run then, and this process is the only one that can ask them, so it must not go. */
  const nothingAllowedYet = () => { try { const { cfg } = launcherConfig(); return cfg.allowedOrigins && cfg.allowedOrigins.length ? null : 'Claude Test: the person has not allowed any address for this project yet' + (cfg.pendingOrigins && cfg.pendingOrigins.length ? ' (waiting: ' + shown(cfg.pendingOrigins.join(' '), 600) + ')' : '') + ', so the test browser stays closed. Run "ct.mjs status" and follow needsConsent: the tool ' + ALLOW_TOOL + ' of this server puts the question to the person. A background run reports BLOCKED with needsConsent.line and ends.'; } catch { return null; } };
  const take = () => { process.stdin.removeListener('data', onData); process.stdin.removeListener('end', onEnd); const rest = buf; buf = ''; return rest; }; // whoever takes the client over gets everything not yet answered, the call that woke us first
  const onData = (chunk) => {
    buf += chunk; let nl;
    while (!booted && (nl = buf.indexOf('\n')) >= 0) {
      const line = buf.slice(0, nl);
      let msg = null; try { msg = JSON.parse(line); } catch { /* not ours to judge */ }
      if (allowTool.take(msg)) { buf = buf.slice(nl + 1); continue; } // answered here, with no start-up: the person's yes must be on record BEFORE the first browser call builds the fence from it
      const mine = !msg || msg.id === undefined || typeof msg.method !== 'string' || msg.method === 'initialize' || msg.method === 'tools/list' || msg.method === 'ping'; // an answer (no method) is never a first call: this stub sends the client no request but the tool's above, so whatever else comes back is nobody's
      const waits = !mine && msg.method === 'tools/call' ? nothingAllowedYet() : null;
      if (waits) { buf = buf.slice(nl + 1); send({ jsonrpc: '2.0', id: msg.id, result: { content: [{ type: 'text', text: waits }], isError: true } }); continue; }
      if (!mine) { booted = true; boot({ initializeParams, take }).catch((e) => { log('start-up failed on first use: ' + (e && e.message ? e.message : e)); process.exit(1); }); return; } // the line stays in buf for the server that takes over
      buf = buf.slice(nl + 1);
      if (!msg || msg.id === undefined || typeof msg.method !== 'string') continue; // notifications (initialized, cancelled) need no answer; the real server is told "initialized" at the hand-off
      const reply = (result) => send({ jsonrpc: '2.0', id: msg.id, result });
      if (msg.method === 'initialize') { initializeParams = msg.params && typeof msg.params === 'object' ? msg.params : null; reply({ protocolVersion: (msg.params && msg.params.protocolVersion) || '2025-06-18', capabilities: { tools: { listChanged: true } }, serverInfo: { name: 'claude-test-browser', version: 'lazy' } }); }
      else if (msg.method === 'tools/list') reply({ tools: [...snapshotTools(), ...setupTools, ...allowTool.tools] });
      else reply({});
    }
  };
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', onData);
  process.stdin.on('end', onEnd);
}

/** The whole start-up. lazy = null (CLAUDE_TEST_EAGER=1: serve stdin at once) or
 *  { initializeParams, take() } from lazyServer: the client has been initialised already and is handed over with its first call pending. */
async function boot(lazy) {
allowTool.fenceBuilt(); // what follows fixes the browser's fence for this process: an address the person allows later is not in it
const SESSION_ROOT = sessionRoot(); // captured before any chdir: what Claude Code opened
const { cfg, note: adoptionNote, served } = launcherConfig(); // the ONE adoption rule (lib/config.mjs), shared with the tools gate
if (adoptionNote) log(adoptionNote);
// Which folders a saved file may land inside, as the file system names them (device and file number), taken now, at the first browser call of the
// session (at the launcher's start with CLAUDE_TEST_EAGER=1): what Claude Code opened and the project served. A folder put at one of these names later has other numbers.
// Windows is not covered by this check.
const LANDING_ROOTS = process.platform === 'win32' ? null : [SESSION_ROOT, cfg.projectDir].flatMap((p) => { try { const st = fs.statSync(fs.realpathSync(p), { bigint: true }); return [{ dev: st.dev, ino: st.ino }]; } catch { return []; } });
// A downloaded browser is looked for only in the plugin's own <tools>/browsers, which "ct.mjs install chromium" fills: never where
// PLAYWRIGHT_BROWSERS_PATH points, and never in the shared folder in the user's cache.
{ const v = (process.env.PLAYWRIGHT_BROWSERS_PATH || '').trim(); if (v && path.resolve(v) !== browsersDir()) log('PLAYWRIGHT_BROWSERS_PATH is set (' + shown(v, 120) + ') and is ignored by the browser server\'s launcher: a downloaded browser is looked for only in ' + browsersDir() + ', where  node ' + fileURLToPath(new URL('./ct.mjs', import.meta.url)) + ' install chromium  puts it'); }
// The same holds for a browser named by its path: this launcher takes an installed Google Chrome (lib/tools.mjs findChrome) or that download, never CLAUDE_TEST_BROWSER_EXECUTABLE.
{ const v = (process.env.CLAUDE_TEST_BROWSER_EXECUTABLE || '').trim(); if (v) log('CLAUDE_TEST_BROWSER_EXECUTABLE is set (' + shown(v, 120) + ') and is ignored by the browser server\'s launcher: it starts an installed Google Chrome, or the browser that  node ' + fileURLToPath(new URL('./ct.mjs', import.meta.url)) + ' install chromium  downloads into ' + browsersDir()); }
delete process.env.CLAUDE_TEST_BROWSER_EXECUTABLE;
delete process.env.PLAYWRIGHT_BROWSERS_PATH;
sanitizeBrowserEnv(); // also removes the npm spellings of that variable from this process
process.env.PLAYWRIGHT_BROWSERS_PATH = browsersDir();
for (const w of cfg.warnings) log(w);
{ const v = (process.env.CLAUDE_TEST_TOOLS_DIR || '').trim(); if (v) log('CLAUDE_TEST_TOOLS_DIR is set (' + shown(v, 120) + ') and is ignored: the browser tooling is run only from ' + toolsDir() + '; a session variable cannot choose it'); }
try { process.chdir(cfg.projectDir); } catch { /* keep cwd */ }
if (LANDING_ROOTS) { let here = null; try { const st = fs.statSync('.', { bigint: true }); here = LANDING_ROOTS.some((w) => w.dev === st.dev && w.ino === st.ino); } catch { here = false; } if (!here) { log('refusing to start: the folder this helper works from is not the one it looked at a moment ago (it was moved or replaced). Reconnect the helper with /mcp'); process.exit(1); } } // the rest of this process reads its working folder afresh
// Git-ignore run artifacts before the server writes any — but only in a project that already uses
// Claude Test (has .claude-testrc or .claude-test/). Once the plugin is installed this server starts
// in every project the user opens, and an unrelated repo must not grow a .claude-test/ folder; a
// first run creates it through "ct.mjs new-run" before any browser output.
// A repository can commit .claude-test or .claude-test/runs as a symlink; the server's output dir
// would then follow it out of the project. Refuse to start in that case (the skill reports BLOCKED).
try { assertRunsDirInsideProject(cfg); } catch (e) { log(e.message + ' — not starting the browser server'); process.exit(1); }
const usesClaudeTest = (cfg.rcFound && (cfg.projectDir !== SESSION_ROOT || rootConfiguresItself(cfg.projectDir))) || isMarked(cfg.projectDir) && !(cfg.projectDir === SESSION_ROOT && cfg.rcFound && !rootConfiguresItself(cfg.projectDir)); // a project that really uses Claude Test (a root whose rc only says "app: …" is not one) — a stray runs-only .claude-test (left by a run started in the wrong folder) does not make us write here; new-run prepares runs/.gitignore when a first run starts
if (usesClaudeTest) { try { ensureRunsDir(cfg); } catch (e) { log('could not create ' + cfg.runsDir + ': ' + e.message); } }

// Everything the server writes goes into a folder of THIS process's own under the plugin's data folder (lib/tools.mjs makeLaunchDir): OUTSIDE
// the repository. That covers the files IT names (downloads a page starts) and the evidence
// the skill asks for by filename: the server follows a link planted at a name a moment earlier, so it is handed a staging name there (lib/vet.mjs)
// and this launcher moves the finished file to the vetted name under .claude-test/runs/<id>/ (placeFiles). The folder goes when this process ends.
let launchDir; try { launchDir = makeLaunchDir(); } catch (e) { log('refusing to start: could not make a folder for this session under the plugin\'s data folder (' + e.message + '). The browser server is only handed files from there: check that the folder named in that error is yours and writable, then reconnect this server (/mcp)'); process.exit(1); }
const outputDir = path.join(launchDir, 'out');
if (!cfg.allowedOrigins || !cfg.allowedOrigins.length) { log('refusing to start: the person has not allowed any address for this project yet' + (cfg.pendingOrigins && cfg.pendingOrigins.length ? ' (waiting: ' + cfg.pendingOrigins.join(' ') + ')' : '') + ' — type /claude-test in Claude Code and answer the dialog it opens'); process.exit(1); } // an empty list is never handed on: upstream would treat it as "no fence"
// --snapshot-mode none: the server attaches NO implicit page snapshot to action results (0.0.79 writes those to <output-dir>/page-*.yml, outside every
// redaction layer here, and the runner would then want to Read them); the runner asks for browser_snapshot when it needs the page, and that answer is inline
// yaml on the wire, where the secret redaction and field scrub apply.
const serverArgs = ['--isolated', '--block-service-workers', '--output-dir', outputDir, '--snapshot-mode', 'none', '--viewport-size', '1280x800']; // no --allowed-origins: the filtering proxy below is the fence, and this launcher checks itself where the navigate tool may go
if (process.env.CLAUDE_TEST_HEADED !== '1') serverArgs.push('--headless');
// ── Network fence ──────────────────────────────────────────────────────────────────────────────────────────────────────
// The browser's only proxy is the FILTERING proxy this launcher owns (block below), with a bypass list of exactly the app's own host:port pairs
// ("<-loopback>" first, so no other local port is implicitly bypassed). Every other connection of any kind — HTTP, WebSocket, worker, beacon — is
// judged there; WebRTC and QUIC, which ride UDP past any proxy, are switched off by launch arguments, and an init script removes WebRTC from every page.
// Only a Chromium-family browser takes that proxy and those arguments, so no other browser is started at all (lib/tools.mjs browserProblem).
// Bypass rules are written WITHOUT a scheme, so ws:// and wss:// to the same host:port match too (a rule spelled "http://host:port" would not cover the
// app's own WebSocket — every dev server's live-reload socket); a port-less host means the scheme's default ports, spelled out, so no entry is
// ever a bare "localhost" (which Chromium AND Playwright read as "all loopback ports").
let networkFence; // what the start-up line says of the fence (set below)
let pinArgs = []; let pinnedNames = []; // --host-resolver-rules for trusted names that reach the app past the proxy (lib/guard.mjs resolverPins), and which names those are
let udpArgs = []; // extra Chromium switches behind the proxy (lib/guard.mjs UDP_FENCE_ARGS), handed to the server in a config file below
let guardSockets = true; // the page-level WebSocket wrap is for where no proxy judges sockets; every run is behind the proxy and sets this false below
let notePageLeftApp = () => {}; // (host) → the filtering proxy's per-run tally also records that a page took the runner off the app (set below when the proxy is on)
{
  { const why = browserProblem(cfg); if (why) { log('refusing to start: ' + why); process.exit(1); } } // never a weaker fence for another browser
  // The FILTERING proxy (lib/fence-proxy.mjs). The browser's only proxy is a listener this launcher owns, and its
  // bypass list ("<-loopback>" first, so no other local port is implicitly bypassed) holds the allowedOrigins that are the app itself: loopback, an address
  // literal, a single-label or .local/.internal/.test-style name, or a name that resolves only to non-public space (a LAN address, a WSL2 or docker host
  // name, a name in /etc/hosts): these are the app's own and go to it directly. Every other connection — scripts, fonts, tiles, XHR, WebSockets,
  // workers, beacons — arrives at the proxy and is judged there, per request:
  //   TRUSTED public origins of allowedOrigins (a staging copy; exact host:port) → tunnelled;
  //   LOAD-ONLY hosts, reachableHosts of .claude-testrc                          → tunnelled, to public addresses only;
  //   anything else                                                              → 403, and counted per run (<run folder>/refused-hosts.json), so the run can say what the app tried to reach.
  // No allowedOrigins host is ever counted as refused. The load-only list is read again when a NEW run folder appears, so an edit to .claude-testrc applies
  // from the next run with no reconnect, and never in the middle of one. On a network that needs its own proxy the tunnels go through that one (HTTPS_PROXY).
  // The navigate tool stays limited to allowedOrigins and saved secrets to the base URL's own origin; when a page takes the runner to a load-only host anyway (a link, a redirect), action
  // tools are refused there until it navigates back (startRealServer).
  const proxySetting = upstreamProxySetting(process.env); const upstream = proxySetting.proxy; // lib/fence-proxy.mjs: HTTPS_PROXY / ALL_PROXY when it names a plain http proxy
  const lookup2s = (host) => Promise.race([dns.promises.lookup(host, { all: true, verbatim: true }), new Promise((_, rej) => setTimeout(() => rej(new Error('slow')), 2000).unref())]); // start-up never waits long on a name
  const bypass = ['<-loopback>']; const viaProxy = []; const appHostPorts = new Set(); const pins = [];
  for (const o of cfg.allowedOrigins) {
    let host; try { host = new URL(/^https?:\/\//.test(o) ? o : 'http://' + o).hostname.toLowerCase().replace(/^\[|\]$/g, ''); } catch { continue; }
    const pairs = bypassOf(o); // lib/guard.mjs: "host:port" as written, without a scheme (so ws:// to the app matches too), never a bare host
    for (const hp of pairs) appHostPorts.add(host + ':' + hp.slice(hp.lastIndexOf(':') + 1));
    const literal = isLocalHost(host) || net.isIP(host) !== 0; // loopback or an address literal: nothing to resolve, nothing to pin
    const localName = !literal && (!host.includes('.') || /\.(localhost|local|internal|test|lan|home|corp|private|intranet|localdomain|home\.arpa)$/.test(host)); // a name no public DNS answers for
    let own = literal || localName;
    if (!literal) {
      // Whatever reaches the app past the proxy is resolved by the browser itself, for every connection — so it is held to the ONE address it has now
      // (--host-resolver-rules), and a name that cannot be held that way does not go past the proxy.
      let addrs = null; let looked = false; try { addrs = await lookup2s(host); looked = true; } catch { addrs = null; }
      if (!looked && !localName) { own = false; log('NOTE could not look up ' + shown(host, 120) + ' within 2 s: it stays behind the fence\'s proxy, which resolves it afresh for every request and refuses a local or private address (an app on a private name that this machine cannot resolve will not load: use its address)'); }
      else if (looked) {
        const priv = (addrs || []).filter((x) => x && x.address && isNonPublicAddress(x.address)); const pub = (addrs || []).filter((x) => x && x.address && !isNonPublicAddress(x.address));
        if (!localName) own = pub.length === 0; // a public-DNS name is the app's own only when it points nowhere public (lvh.me, nip.io, a name of the person's own)
        if (own && priv.length) {
          const plain = priv.map((x) => plainAddress(x.address)).filter(Boolean); const pick = plain.find((x) => x.family === 4) || plain[0]; // an IPv4-mapped answer is pinned as the IPv4 address it carries
          if (pick && resolverPins([{ name: host, address: pick.address }])) pins.push({ name: host, address: pick.address });
          else if (!localName) { own = false; log('NOTE ' + shown(host, 120) + ' resolves to private space but cannot be held to one address (an unusual name or address form): it stays behind the fence\'s proxy'); }
        }
      } // a local name this machine's resolver does not answer for (mDNS through the browser only, say) stays as it was: no public DNS can answer for it either
    }
    (own ? bypass : viaProxy).push(...pairs);
  }
  let reach = { runId: undefined, entries: cfg.reachableHosts || [], match: makeReachableMatcher(cfg.reachableHosts || []) };
  let tally = new Map(); let leftFor = new Map(); let tallyDirty = false; let lastLook = 0; let ranId = null;
  /** Write <run>/refused-hosts.json the way the launcher writes any file into a run folder: only into one of this project's own run folders, with runs/
   *  still inside the project, never through a link or onto a hard-linked file, from inside the folder itself (placeStagedFile). */
  const flushTally = () => {
    if (!tallyDirty) return; tallyDirty = false; if (!reach.runId) return;
    const dir = path.join(cfg.runsDir, reach.runId);
    try {
      assertRunsDirInsideProject(cfg); // runs/ itself still resolves inside the project (lib/config.mjs; throws otherwise)
      const realDir = fs.realpathSync(dir);
      if (!fs.lstatSync(dir).isDirectory() || realDir !== path.join(fs.realpathSync(cfg.runsDir), reach.runId)) return; // a real folder directly under runs/, not a link elsewhere
      // Written in this process's own folder first and placed like every other file that lands in a run folder (lib/runs.mjs placeStagedFile): a folder
      // on the way swapped for a link between the look above and the create lands nothing elsewhere. A refusal is dropped: the tally is a convenience.
      const staged = path.join(launchDir, 'refused-hosts.' + crypto.randomBytes(6).toString('hex') + '.json');
      fs.writeFileSync(staged, JSON.stringify({ run: reach.runId, reachableHosts: reach.entries, refused: Object.fromEntries([...tally.entries()].sort((a, b) => b[1] - a[1]).slice(0, 200)), ...(leftFor.size ? { pageLeftAppFor: Object.fromEntries(leftFor) } : {}) }, null, 1) + '\n', { mode: 0o600, flag: 'wx' });
      placeStagedFile(staged, path.join(realDir, 'refused-hosts.json'), { within: LANDING_ROOTS && { root: fs.realpathSync(cfg.projectDir), anchors: LANDING_ROOTS }, mode: 0o600 });
    } catch { /* the run folder is gone or not ours: nothing to record */ }
  };
  // WHEN the list is read again: while no run is going on, whenever .claude-testrc has changed (so "allow them" applies without a reconnect), and at the
  // moment a run begins (its progress.ndjson appears); once a run is going on (progress.ndjson there, results.json not) the list is fixed until it ends —
  // nothing a page says mid-run can widen what that run reaches. The tally is per run folder.
  const rcFiles = [...new Set([cfg.rcPath, path.join(cfg.projectDir, '.claude-testrc')].filter(Boolean))];
  const rcStamp = () => rcFiles.map((f) => { try { const st = fs.statSync(f); return st.mtimeMs + ':' + st.size; } catch { return '-'; } }).join('|');
  let lastState = null; let lastRc = rcStamp();
  const lookForNewRun = () => {
    const now = Date.now(); if (now - lastLook < 2000) return; lastLook = now;
    const id = runFolders(cfg).pop() || null; let running = false; // lib/runs.mjs: the newest of this project's own run folders, as ct.mjs counts them (real folders, not future-dated, not committed content)
    if (id) { try { const d = path.join(cfg.runsDir, id); running = fs.existsSync(path.join(d, 'progress.ndjson')) && !fs.existsSync(path.join(d, 'results.json')); } catch { running = false; } }
    const state = (id || '') + (running ? '|running' : '|idle');
    if (id !== reach.runId) { flushTally(); tally = new Map(); leftFor = new Map(); reach.runId = id; ranId = null; }
    if (running && ranId !== id) { ranId = id; if (tally.size || leftFor.size) { tally = new Map(); leftFor = new Map(); tallyDirty = true; } } // the run begins: a first look shares its folder, and what THAT was refused is not "refused during this run"
    if (running && state === lastState) return; // mid-run: fixed
    const rc = rcStamp(); if (state === lastState && rc === lastRc) return;
    lastState = state; lastRc = rc;
    let entries = reach.entries; try { entries = loadConfig(cfg.projectDir).reachableHosts || []; } catch { /* an unreadable rc keeps the list in use */ }
    if (JSON.stringify(entries) !== JSON.stringify(reach.entries)) { reach = { runId: reach.runId, entries, match: makeReachableMatcher(entries) }; log('reachableHosts now: ' + (entries.length ? entries.join(' ') : '(none)') + (running ? ' (run ' + id + ' begins with these)' : '')); }
  };
  const allow = (host, port) => { lookForNewRun(); return appHostPorts.has(host + ':' + port) || reach.match(host, port); };
  const onRefused = (host, port) => { if (!/^[a-z0-9.-]{1,253}$/.test(host) || appHostPorts.has(host + ':' + port)) return; const k = host + ':' + port; if (tally.size >= 400 && !tally.has(k)) return; tally.set(k, (tally.get(k) || 0) + 1); tallyDirty = true; };
  notePageLeftApp = (host) => { lookForNewRun(); if (!reach.runId || !/^[a-z0-9.:[\]-]{1,260}$/i.test(host)) return; if (leftFor.size >= 50 && !leftFor.has(host)) return; leftFor.set(host, (leftFor.get(host) || 0) + 1); tallyDirty = true; };
